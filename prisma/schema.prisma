datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String   // bcrypt hashed
  name      String
  role      Role     @default(SELLER)
  createdAt DateTime @default(now())
  orders    Order[]
}

enum Role {
  ADMIN
  SELLER
}

model Product {
  id           String      @id @default(cuid())
  name         String
  sku          String?     @unique
  description  String?
  category     String?
  baseUnit     BaseUnit    // canonical storage unit (g, mL, or UNIT)
  basePrice    Decimal     @db.Decimal(18, 6)  // price per 1 baseUnit in paise (INR × 100)
  stockQty     Decimal     @db.Decimal(18, 6)  // quantity in baseUnit
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  orderItems   OrderItem[]
}

enum BaseUnit {
  GRAM
  MILLILITER
  UNIT
}

model Order {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id])
  status      OrderStatus @default(PENDING)
  totalPaise  Decimal     @db.Decimal(18, 2)  // total in paise
  notes       String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  items       OrderItem[]
}

enum OrderStatus {
  PENDING
  CONFIRMED
  REJECTED
  FULFILLED
}

model OrderItem {
  id             String    @id @default(cuid())
  orderId        String
  order          Order     @relation(fields: [orderId], references: [id])
  productId      String
  product        Product   @relation(fields: [productId], references: [id])
  orderedUnit    String    // the unit the user chose: g, kg, mL, L, unit
  orderedQty     Decimal   @db.Decimal(18, 6)  // quantity in orderedUnit
  baseQty        Decimal   @db.Decimal(18, 6)  // converted to baseUnit
  unitPricePaise Decimal   @db.Decimal(18, 6)  // price per orderedUnit in paise
  lineTotalPaise Decimal   @db.Decimal(18, 2)  // orderedQty × unitPricePaise
}
